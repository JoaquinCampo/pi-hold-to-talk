{
  "name": "pi-hold-to-talk",
  "version": "0.1.0",
  "description": "Hold Space to dictate into Pi. Fully local speech recognition on Apple Silicon, with live words in the prompt and a near-instant final pass.",
  "type": "module",
  "license": "MIT",
  "author": "Joaquin Campo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoaquinCampo/pi-hold-to-talk.git"
  },
  "homepage": "https://github.com/JoaquinCampo/pi-hold-to-talk#readme",
  "bugs": {
    "url": "https://github.com/JoaquinCampo/pi-hold-to-talk/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "dictation",
    "voice",
    "speech-to-text",
    "push-to-talk",
    "macos"
  ],
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "video": "https://github.com/JoaquinCampo/pi-hold-to-talk/releases/download/v0.1.0/pi-hold-to-talk-demo.mp4"
  },
  "files": [
    "src",
    "bin",
    "helper/Package.swift",
    "helper/Package.resolved",
    "helper/Sources",
    "scripts/build-helper.sh",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build:helper": "scripts/build-helper.sh",
    "prepack": "scripts/build-helper.sh",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
